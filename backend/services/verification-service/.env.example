PORT=4007
DATABASE_URL=postgresql://fixmyinfra:fixmyinfra@localhost:5432/fixmyinfra
RABBITMQ_URL=amqp://guest:guest@localhost:5672
AI_SERVICE_URL=http://localhost:8000

# Signs the JWTs this service issues and verifies. Must be identical
# across the gateway and every service.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-value

# Shared secret that proves a request reached this service through the API
# gateway. Services reject traffic without it, so nobody can call a service
# port directly and forge the X-User-* identity headers.
# Must be identical across the gateway and every service.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-value
