PORT=4000

# Signs the JWTs the gateway issues and verifies on every protected route.
# Must be identical across the gateway and every service.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-value

# Stamped onto every proxied request. It is what allows each service to trust
# the X-User-* headers the gateway injects after validating the JWT.
# Must be identical across the gateway and every service.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-value
