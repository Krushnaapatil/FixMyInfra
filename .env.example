# Copy to .env and fill in secrets. Never commit .env.
# Used by: docker compose -f infra/docker-compose.prod.yml up -d --build

# --- Required: no defaults, compose fails fast without these ---
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET and INTERNAL_SERVICE_TOKEN must match the values in each service's
# .env. INTERNAL_SERVICE_TOKEN is what lets a service trust the identity headers
# the gateway injects; see SECURITY.md.
JWT_SECRET=change-me-to-a-long-random-string
INTERNAL_SERVICE_TOKEN=change-me-to-a-long-random-string-at-least-32-chars
POSTGRES_PASSWORD=change-me-to-a-strong-password

# --- Database / broker (defaults suit a single-host Nashik deployment) ---
POSTGRES_USER=fixmyinfra
POSTGRES_DB=fixmyinfra
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- Public ports ---
GATEWAY_PORT=4000
CITIZEN_PORT=5173
DEPARTMENT_PORT=5174
ADMIN_PORT=5175

# --- Gateway CORS: comma-separated origins, e.g.
# CORS_ORIGIN=https://fixmyinfra.nmc.gov.in,https://officers.fixmyinfra.nmc.gov.in
# Keep * for local evaluation only.
CORS_ORIGIN=*
